{
  "required": true,
  "minVersion": "0.8.7",
  "mixinextras": {
    "minVersion": "0.5.5"
  },
  "compatibilityLevel": "JAVA_${java_version_major}",
  "package": "net.sbo.mod.mixin",
  "plugin": "net.sbo.mod.mixinbase.SBOMixinPlugin",
  "injectors": {
    "defaultRequire": 1,
    "maxShiftBy": 2
  },
  "overwrites": {
    "requireAnnotations": true,
    "conformVisibility": true
  }
}
